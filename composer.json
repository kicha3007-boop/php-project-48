{
    "name": "hexlet/code",
    "description": "gendiff: compares two configuration files (JSON, YAML) and shows the difference",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Kichigin Sergey"
        }
    ],
    "bin": [
        "bin/gendiff"
    ],
    "autoload": {
        "files": [
            "src/Differ.php",
            "src/Parsers.php",
            "src/DiffTree.php",
            "src/Formatters.php",
            "src/Formatters/Stylish.php",
            "src/Formatters/Plain.php",
            "src/Formatters/Json.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Differ\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.3",
        "docopt/docopt": "^1.0",
        "symfony/yaml": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.13"
    }
}
